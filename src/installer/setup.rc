/* Installer resources. DDRAW_DLL and PROXY_INI are defined by build/build_installer.sh (this build's proxy). */
#include <windows.h>
#include "version.gen.h"
1 RT_MANIFEST "setup.manifest"
101 RCDATA DDRAW_DLL
102 RCDATA PROXY_INI
VS_VERSION_INFO VERSIONINFO
FILEVERSION PROXY_VERSION_RC
PRODUCTVERSION PROXY_VERSION_RC
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "0c0904b0"
    BEGIN
      VALUE "FileDescription", "ultdaytonausa installer for Daytona USA (PC, v1.1)"
      VALUE "ProductName", "ultdaytonausa (not affiliated with Sega)"
      VALUE "FileVersion", PROXY_VERSION_STR
      VALUE "ProductVersion", PROXY_VERSION_STR
      VALUE "LegalCopyright", "CC0 1.0 (libFLAC: BSD licence; dr_flac: public domain)"
      VALUE "OriginalFilename", "ultdaytonausa-setup.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0c09, 1200
  END
END
